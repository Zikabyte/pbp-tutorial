from django.test import Client
from django.test.utils import override_settings
from django.urls import reverse
from main.models import Project

with override_settings(ALLOWED_HOSTS=['*']):
    c = Client()
    proj = Project.objects.first()
    print('sample project:', proj.name if proj else None)

    # GET edit page, check prefill + title tag + main tag count
    resp = c.get(reverse('main:update_project', kwargs={'project_id': proj.id}))
    content = resp.content.decode()
    print('status:', resp.status_code)
    print('name prefilled:', proj.name in content)
    print('<main> tag count:', content.count('<main'))
    import re
    title_match = re.search(r'<title>(.*?)</title>', content, re.S)
    print('rendered <title>:', title_match.group(1).strip() if title_match else None)

    # POST update
    resp2 = c.post(reverse('main:update_project', kwargs={'project_id': proj.id}), data={
        'name': proj.name,
        'description': proj.description,
        'image_url': proj.image_url or '',
        'category': proj.category,
        'project_url': proj.project_url or '',
    }, follow=True)
    print('POST status:', resp2.status_code)
" 2>&1 | grep -v "^\["

