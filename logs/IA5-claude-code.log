Bash Set explicit text color on modal and toast popovers to fix black text in dark mode
IN
python3 - <<'EOF'
import re
p = "static/css/_project-form.css"
s = open(p, encoding="utf-8").read()
old = ".project-form-modal {\n\tdisplay: none;"
assert s.count(old) == 1, "modal block not found"
s = s.replace(old, ".project-form-modal {\n\tdisplay: none;\n\tcolor: var(--ink);")
old_c = ".project-form-modal__content {\n\tposition: relative;"
assert s.count(old_c) == 1
s = s.replace(old_c, ".project-form-modal__content {\n\tposition: relative;\n\tcolor: var(--ink);")
open(p, "w", encoding="utf-8").write(s)

p = "static/css/_toast.css"
s = open(p, encoding="utf-8").read()
assert s.count("\tcolor: inherit;") == 1
s = s.replace("\tcolor: inherit;", "\tcolor: var(--ink);")
open(p, "w", encoding="utf-8").write(s)
print("ok")
EOF
