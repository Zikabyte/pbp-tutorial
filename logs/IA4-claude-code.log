Bash Verify starred-only filter using response content instead of context
IN
./.venv/Scripts/python.exe manage.py shell -c "
from django.test import Client
from django.test.utils import override_settings
from django.urls import reverse
from django.contrib.auth.models import User
from main.models import Project

with override_settings(ALLOWED_HOSTS=['*']):
    p1 = Project.objects.create(name='Distar', description='d', category='general')
    p2 = Project.objects.create(name='TidakDistar', description='d', category='general')

    u = User.objects.create_user(username='_tmp_star_filter', password='pass12345')
    p1.starred_by.add(u)

    c = Client()
    c.login(username='_tmp_star_filter', password='pass12345')

    html = c.get(reverse('main:show_projects'), {'starred': '1'}).content.decode()
    print('Filter starred=1 (login) -> Distar ada?', 'Distar</h3>' in html, '| TidakDistar ada?', 'TidakDistar</h3>' in html)

    html2 = c.get(reverse('main:show_projects')).content.decode()
    print('Tanpa filter (login) -> Distar ada?', 'Distar</h3>' in html2, '| TidakDistar ada?', 'TidakDistar</h3>' in html2)

    anon = Client()
    html3 = anon.get(reverse('main:show_projects'), {'starred': '1'}).content.decode()
    print('Filter starred=1 (anonymous, harus diabaikan) -> Distar ada?', 'Distar</h3>' in html3, '| TidakDistar ada?', 'TidakDistar</h3>' in html3)

    p1.delete(); p2.delete()
    User.objects.filter(username='_tmp_star_filter').delete()
    print('cleaned up')
" 2>&1 | grep -v "^\["

