from django.test import Client
from django.test.utils import override_settings
from django.urls import reverse
from django.contrib.auth.models import User
from main.models import Project

with override_settings(ALLOWED_HOSTS=['*']):
    p1 = Project.objects.create(name='Distar', description='d', category='general')
    p2 = Project.objects.create(name='TidakDistar', description='d', category='general')

    u = User.objects.create_user(username='_tmp_star_filter', password='pass12345')
    p1.starred_by.add(u)

    c = Client()
    c.login(username='_tmp_star_filter', password='pass12345')

    resp = c.get(reverse('main:show_projects'), {'starred': '1'})
    names = [p.name for p in resp.context['project_list']]
    print('Filter starred=1 (login):', names)

    resp2 = c.get(reverse('main:show_projects'))
    names2 = [p.name for p in resp2.context['project_list']]
    print('Tanpa filter (login):', names2)

    anon = Client()
    resp3 = anon.get(reverse('main:show_projects'), {'starred': '1'})
    names3 = [p.name for p in resp3.context['project_list']]
    print('Filter starred=1 (anonymous, harus diabaikan):', names3)

    p1.delete(); p2.delete()
    User.objects.filter(username='_tmp_star_filter').delete()
    print('cleaned up')
" 2>&1 | grep -v "^\["

